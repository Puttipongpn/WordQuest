{
  "name": "vocab-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "normalize-assets": "node ./scripts/normalize-assets.mjs",
    "normalize-assets:dry-run": "node ./scripts/normalize-assets.mjs --dry-run",
    "normalize-assets:fix": "node ./scripts/fix-normalized-assets.mjs",
    "normalize-assets:fix:dry-run": "node ./scripts/fix-normalized-assets.mjs --dry-run",
    "normalize-assets:refine": "node ./scripts/refine-normalized-assets.mjs",
    "asset-qa-previews:refined": "node ./scripts/generate-fixed-asset-qa-previews.mjs --refined",
    "normalize-assets:refined-full": "node ./scripts/normalize-assets-refined-full.mjs",
    "asset-qa-previews:refined-full": "node ./scripts/generate-fixed-asset-qa-previews.mjs --full-refined"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
